AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
STRICT_RESOURCES=false
GITHUB_TOKEN=optional_github_token_for_higher_rate_limit
AFFINDA_API_KEY=optional_affinda_api_key_for_resume_skill_extraction
AFFINDA_API_URL=https://api.affinda.com/v3/documents
AFFINDA_WORKSPACE_ID=required_affinda_workspace_id
AFFINDA_DOCUMENT_TYPE=optional_resume_document_type_identifier
AFFINDA_COLLECTION=optional_collection_identifier
AFFINDA_DEBUG_RAW_JSON=false
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
DATABASE_URL=postgresql://gapsolver:gapsolver@localhost:5433/gapsolver
